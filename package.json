    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@types/react": "^19.2.14",
    "hono": "^4.12.19",
    "react": "^19.2.6",
    "typescript": "^5.8.3",
