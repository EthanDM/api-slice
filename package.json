{
  "name": "@ethandm/api-slice",
  "version": "0.1.0",
  "description": "Typed resource and backend action layer for TypeScript apps.",
  "author": "Ethan Millstein <me@ethandm.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EthanDM/api-slice.git"
  },
  "bugs": {
    "url": "https://github.com/EthanDM/api-slice/issues"
  },
  "homepage": "https://github.com/EthanDM/api-slice#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./recorder": {
      "types": "./dist/recorder.d.ts",
      "default": "./dist/recorder.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./react-query": {
      "types": "./dist/react-query.d.ts",
      "default": "./dist/react-query.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "skills",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "typescript",
    "api",
    "resource",
    "zod",
    "hono",
    "tanstack-query",
    "react-query",
    "react-native",
    "fetch"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run typecheck:examples && npm test && npm run build && npm run smoke:pack",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "hono": "^4.0.0",
    "react": ">=18.0.0 <20.0.0",
    "zod": "^3.25.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@types/react": "^19.2.14",
    "hono": "^4.12.19",
    "react": "^19.2.6",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "zod": "^3.25.0"
  }
}
